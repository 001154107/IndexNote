# =============================================================================
# IndexNote Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- LLM Provider -----------------------------------------------------------
# Options: "ollama" (local, private) or "gemini" (cloud, requires API key)
LLM_PROVIDER=ollama

# --- Ollama Settings (when LLM_PROVIDER=ollama) -----------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# Vision model for image/video description (must support vision)
OLLAMA_VISION_MODEL=llava

# --- Gemini Settings (when LLM_PROVIDER=gemini) -----------------------------
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=models/text-embedding-004

# --- Paths -------------------------------------------------------------------
SOURCE_NOTES_DIR=./source_notes
DATA_DIR=./data

# --- Indexing ----------------------------------------------------------------
CHUNK_SIZE=1024
CHUNK_OVERLAP=128

# Max entity-relation-entity triples extracted per text chunk
KG_MAX_PATHS_PER_CHUNK=10

# --- File Watcher ------------------------------------------------------------
# Auto-reindex changed files without prompting (true/false)
AUTO_REINDEX=false

# Debounce window in seconds for file change events
WATCHER_DEBOUNCE_SECONDS=2.0

# --- Audio/Video (optional) --------------------------------------------------
# Whisper model size: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=base

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
